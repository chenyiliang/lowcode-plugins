{
  "name": "@alilc/lowcode-plugin-multiple-editor",
  "version": "0.2.0",
  "description": "alibaba lowcode editor multiple-file code editor plugin",
  "author": {
    "name": "wsh",
    "email": "913003120@qq.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/lowcode-plugin-multiple-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-plugin-base-monaco-editor": "workspace:*",
    "@alilc/lowcode-shell": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/standalone": "^7.29.7",
    "@babel/template": "^7.28.9",
    "@babel/types": "^7.29.8",
    "@monaco-editor/loader": "^1.7.0",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "prettier": "^2.8.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "less": "^4.9.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/lowcode-plugins.git",
    "directory": "packages/plugin-multiple-editor"
  }
}
