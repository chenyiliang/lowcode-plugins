{
  "name": "@alilc/lowcode-plugin-datasource-pane",
  "version": "1.0.11",
  "description": "低代码引擎数据源面板",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/lowcode-plugin-datasource-pane.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-datasource-types": "workspace:*",
    "@alilc/lowcode-editor-core": "workspace:*",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-plugin-base-monaco-editor": "workspace:*",
    "@alilc/lowcode-shell": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "@formily/core": "^2.3.7",
    "@formily/next": "^2.3.7",
    "@formily/react": "^2.3.7",
    "ajv": "^8.20.0",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "react-error-boundary": "^6.1.6",
    "traverse": "^0.6.14",
    "xstate": "^5.33.3",
    "zen-logger": "^1.1.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.3.0",
    "@types/traverse": "^0.6.37",
    "@vitejs/plugin-react": "^6.1.2",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/lowcode-plugins.git",
    "directory": "packages/plugin-datasource-pane"
  }
}
