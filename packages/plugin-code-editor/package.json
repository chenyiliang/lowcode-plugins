{
  "name": "@alilc/lowcode-plugin-code-editor",
  "version": "1.0.9",
  "description": "CodeEditor",
  "author": "59174526@qq.com & humphry.huang9@gmail.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/lowcode-plugin-code-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-plugin-base-monaco-editor": "workspace:*",
    "@alilc/lowcode-shell": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.9",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "js-beautify": "^2.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/js-beautify": "^1.14.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "less": "^4.9.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
