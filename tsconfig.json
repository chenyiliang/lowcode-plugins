{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vite 客户端类型：为 *.css / *.scss / *.less / *.svg / *.png 等副作用与资源导入
    // 提供模块声明（TS 7 对无声明的副作用导入会报 TS2882）
    "types": ["vite/client"]
  },
  "include": ["packages/*/src"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/lib",
    "**/es",
    "**/build",
    "**/test",
    "**/tests",
    "**/demo",
    "**/config",
    "**/scripts",
    "**/dev-config",
    "**/schema"
  ]
}
