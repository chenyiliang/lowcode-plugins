{
  "name": "ali-lowcode-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Ali LowCode Engine official plugins (React 19 + Vite)",
  "repository": "https://github.com/alibaba/lowcode-plugins.git",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "clean": "pnpm --filter \"./packages/*\" --parallel clean",
    "typecheck": "pnpm --filter \"./packages/*\" --parallel typecheck",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx ./ --quiet",
    "lint:fix": "eslint --ext .ts,.tsx,.js,.jsx ./ --quiet --fix"
  },
  "devDependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
